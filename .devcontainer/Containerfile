# Dev cage sandbox image (aegir-infra ADR-0025). Dependencies are installed
# from the lockfile at build time; the agent's sandbox runs with no network.
# The repo is mounted at /workspace, and its node_modules is a symlink to
# /opt/repo-scorer/node_modules. A dependency change means a lockfile edit,
# then a rebuild outside the cage.
#
# Node 24 matches production. The full bookworm image carries python3 (the
# agent's code tool needs it) and a compiler for better-sqlite3. Hermes mounts
# over /root and /tmp, so nothing is installed there.
FROM docker.io/library/node:24-bookworm

WORKDIR /opt/repo-scorer
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

WORKDIR /workspace
